{
  // Config voor deploy als Cloudflare Worker met static assets.
  "name": "vamos",
  "compatibility_date": "2026-07-01",
  // Worker-script: serveert assets én proxyt /api/playtomic/* naar Playtomic.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    // Binding zodat de Worker de static assets kan serveren (env.ASSETS).
    "binding": "ASSETS",
    // SPA-fallback: serveer index.html voor onbekende paden (client-side routes
    // zoals /login blijven werken bij refresh/deep-links). Dit vervangt de
    // /* -> /index.html 200 regel in _redirects, die door de asset-router als
    // oneindige lus wordt afgekeurd.
    "not_found_handling": "single-page-application"
  },
  // Egress-hop voor de availability-fetch (#385): playtomic.com/api blokkeert
  // Cloudflare-egress (CloudFront-WAF, 403); de Supabase Edge Function mag er
  // wél doorheen. De URL is publiek (zelfde project als de frontend-API).
  "vars": {
    "PLAYTOMIC_EGRESS": "https://fuxjxorbbebbxxgsnyon.supabase.co/functions/v1/playtomic-availability"
  },
  // Crashmeldingen (#733) komen als logregel binnen via /api/client-error;
  // zonder observability zou die regel nergens naartoe gaan.
  "observability": { "enabled": true },
  // Per-IP rate limiting voor de publieke Playtomic-proxy: max 20 verzoeken
  // per 10 seconden per IP. period mag alleen 10 of 60 zijn.
  "unsafe": {
    "bindings": [
      {
        "name": "PLAYTOMIC_RL",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 10 }
      },
      // Eigen budget voor de crashmeldingen: dat endpoint is publiek en
      // ongeauthenticeerd, en mag de proxy niet in de weg zitten. Vijf per
      // minuut per IP is ruim — de client stopt zelf al na vijf per sessie.
      {
        "name": "FOUT_RL",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}