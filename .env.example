# Kopieer naar .env en vul in. Alleen VITE_-prefixed vars zijn zichtbaar in de frontend.
#
# LOKAAL (supabase start):
#   VITE_SUPABASE_URL=http://localhost:54321
#   VITE_SUPABASE_ANON_KEY=<lokale publishable/anon key uit `supabase status`>
#
# PRODUCTIE (Cloudflare Worker via GitHub Actions):
#   Zet deze NIET in .env (die wordt niet gecommit), maar als GitHub-secrets
#   (repo -> Settings -> Secrets and variables -> Actions). De deploy-workflow
#   (.github/workflows/deploy.yml) bouwt ermee en deployt de Worker bij elke
#   push naar main. Wijs ze naar je GEHOSTE Supabase-project:
#   VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon/publishable key uit Supabase -> Project Settings -> API>
#   De anon/publishable key is publiek en veilig te exposen, mits RLS aanstaat.
#   Daarnaast nodig: CLOUDFLARE_API_TOKEN (met Workers-edit-rechten) en
#   CLOUDFLARE_ACCOUNT_ID.

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Publieke VAPID-sleutel voor push-meldingen (npx web-push generate-vapid-keys).
# Zonder deze sleutel verbergt de app de meldingen-optie gewoon.
# De PRIVÉ-sleutel hoort NIET hier maar in de Supabase-secrets (zie
# supabase/functions/send-push/README.md).
VITE_VAPID_PUBLIC_KEY=
