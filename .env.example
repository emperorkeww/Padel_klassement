# Kopieer naar .env en vul in. Alleen VITE_-prefixed vars zijn zichtbaar in de frontend.
#
# LOKAAL (supabase start):
#   VITE_SUPABASE_URL=http://localhost:54321
#   VITE_SUPABASE_ANON_KEY=<lokale publishable/anon key uit `supabase status`>
#
# PRODUCTIE (Cloudflare Pages):
#   Zet deze NIET in .env (die wordt niet meegebouwd/gecommit), maar in
#   Cloudflare Pages -> Settings -> Environment variables (Production).
#   Wijs ze naar je GEHOSTE Supabase-project:
#   VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon/publishable key uit Supabase -> Project Settings -> API>
#   De anon/publishable key is publiek en veilig te exposen, mits RLS aanstaat.

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-public-key
